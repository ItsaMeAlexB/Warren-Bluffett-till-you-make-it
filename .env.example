# News: stockdata.org (global news; free tier ~100 requests/day).
# Keys are comma-separated lists (1..N), tried in order with failover on
# quota/auth (401/402/403/429). The single-key vars below are backward-compat
# aliases; the *_KEYS list takes precedence when set.
STOCKDATA_KEYS=your_stockdata_key_here,optional_second_stockdata_key
# Fundamentals: eulerpool (richer financial data).
EULERPOOL_KEYS=your_eulerpool_key_here
# Legacy single-key aliases (still honoured if *_KEYS is unset):
# STOCKDATA_API_KEY=...
# STOCKDATA_API_KEY_2=...
# EULERPOOL_API_KEY=...
# Finnhub key - TRAINING ONLY sentiment fill (when StockData has zero articles
# at T-20). Never used in the live scan.
FINNHUB_KEY=your_finnhub_key_here
